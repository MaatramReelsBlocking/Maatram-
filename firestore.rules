rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.points is int
                    && request.resource.data.points >= 0;
      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.points is int
                    && request.resource.data.points >= 0
                    && (
                         // normal play: penalties and gains capped
                         (   request.resource.data.points >= resource.data.points - 100
                          && request.resource.data.points <= resource.data.points + 200)
                         // monthly cycle roll: own board zeroed when the month changes
                      || (   request.resource.data.points == 0
                          && request.resource.data.cycle != resource.data.cycle)
                       );
      allow delete: if false;
    }

    // sports events: any signed-in user lists one, only Maatram takes it down
    match /events/{id} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.by == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 80
                    && request.resource.data.date is string;
      // only the Maatram account edits or removes a listing - not the author, not students
      allow update, delete: if request.auth != null
                    && request.auth.token.email == 'maatram97@gmail.com';
    }

    // classes: created by a teacher, joined (read-only) by students and parents
    match /classes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.teacherUid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
